            clickBtn.BackgroundTransparency = 1
            clickBtn.Text = ""
            clickBtn.ZIndex = 10
            
            -- Наводим на предмет - подсвечиваем
            clickBtn.MouseEnter:Connect(function() base.Material = Enum.Material.Neon end)
            clickBtn.MouseLeave:Connect(function() base.Material = Enum.Material.SmoothPlastic end)
            
            -- Нажатие на предмет
            clickBtn.MouseButton1Click:Connect(function()
                if isDealer then
                    -- Если это предмет дилера, и мы в режиме кражи
                    if GameState.StealingMode and GameState.Turn == "Player" and not GameState.Busy then
                        GameState.StealingMode = false
                        GameState.Busy = true
                        for i, n in ipairs(GameState.DealerItems) do
                            if n == itemName then
                                table.remove(GameState.DealerItems, i)
                                break
                            end
                        end
                        clearItems()
                        render3DItems()
                        UseItem("Player", itemName)
                        GameState.Busy = false
                    end
                else
                    -- Если это предмет игрока
                    if GameState.Turn == "Player" and not GameState.StealingMode and not GameState.Busy then
                        GameState.Busy = true
                        for i, n in ipairs(GameState.PlayerItems) do
                            if n == itemName then
                                table.remove(GameState.PlayerItems, i)
                                break
                            end
                        end
                        clearItems()
                        render3DItems()
                        UseItem("Player", itemName)
                        GameState.Busy = false
                    end
                end
            end)
            
            table.insert(ClickButtons, clickBtn)
        end
