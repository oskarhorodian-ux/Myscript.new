            targetCF = CFrame.new(2, 0.9, 2) * CFrame.Angles(math.rad(-15), math.rad(145), 0)
        else
            targetCF = CFrame.new(0, 0.35, 0) * CFrame.Angles(0, math.rad(90), 0)
        end

        for step = 1, 15 do
            GunRoot.CFrame = GunRoot.CFrame:Lerp(targetCF, 0.3)
            syncGunParts()
            task.wait(0.02)
        end

        playSFX(SOUNDS.Heartbeat, 1.0, 1.0)
        LogLabel.Text = "⏳ Интрига..."
        LogLabel.TextColor3 = Color3.fromRGB(255, 150, 50)
        task.wait(1.5)

        if isLive then
            playSFX(SOUNDS.Shot, 0.95, 1.0)
            local origCam = Camera.CFrame
            for _ = 1, 5 do
                Camera.CFrame = origCam * CFrame.new(math.random(-10, 10)/100, math.random(-10, 10)/100, 0)
                task.wait(0.02)
            end
            Camera.CFrame = origCam
            
            MainFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            TweenService:Create(MainFrame, TweenInfo.new(0.5), {BackgroundColor3 = Color3.fromRGB(10, 10, 12)}):Play()

            local recoilCF = targetCF * CFrame.new(0, 0.3, 0.7) * CFrame.Angles(math.rad(25), 0, 0)
            GunRoot.CFrame = recoilCF
            syncGunParts()

            local origPos = MainFrame.Position
            for _ = 1, 6 do
                MainFrame.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + math.random(-12, 12), origPos.Y.Scale, origPos.Y.Offset + math.random(-12, 12))
                task.wait(0.025)
            end
            MainFrame.Position = origPos
        else
            playSFX(SOUNDS.Blank, 1.1)
            MainFrame.BackgroundColor3 = Color3.fromRGB(100, 180, 255)
            TweenService:Create(MainFrame, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(10, 10, 12)}):Play()
        end

        task.wait(0.3)

        local restCF = CFrame.new(0, 0.35, 0) * CFrame.Angles(0, math.rad(90), 0)
        for step = 1, 10 do
            GunRoot.CFrame = GunRoot.CFrame:Lerp(restCF, 0.35)
            syncGunParts()
            task.wait(0.02)
        end
        LogLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    end

    local function loadShotgun()
        playSFX(SOUNDS.Rack, 1.0)
        GameState.Shells = {}
        GameState.SawActive = false
        local total = math.random(3, 8)
        local liveCount = math.clamp(math.floor(total / 2) + math.random(0, 1), 1, total - 1)
        
        for _ = 1, liveCount do table.insert(GameState.Shells, true) end
        for _ = 1, (total - liveCount) do table.insert(GameState.Shells, false) end
        for i = #GameState.Shells, 2, -1 do
            local j = math.random(1, i)
            GameState.Shells[i], GameState.Shells[j] = GameState.Shells[j], GameState.Shells[i]
        end

        GameState.PlayerItems = {}
        GameState.DealerItems = {}
        for _ = 1, math.random(2, 4) do
            table.insert(GameState.PlayerItems, ITEM_NAMES[math.random(1, #ITEM_NAMES)])
            table.insert(GameState.DealerItems, ITEM_NAMES[math.random(1, #ITEM_NAMES)])
        end

        renderInventories()
        updateHPUI()
        LogLabel.Text = string.format("🔄 ОБОЙМА: 🔴 %d БОЕВЫХ | 🔵 %d ХОЛОСТЫХ", liveCount, total - liveCount)
        LogLabel.TextColor3 = Color3.fromRGB(255, 215, 90)
    end

    local function startNewGame()
        GameState.Round = 1
        GameState.MaxHP = math.random(3, 5)
        GameState.PlayerHP = GameState.MaxHP
        GameState.DealerHP = GameState.MaxHP
        GameState.GameOver = false
        GameState.Busy = false
        ShootDealerBtn.Text = "🔫 ВЫСТРЕЛИТЬ В ДИЛЕРА"
        ShootSelfBtn.Text = "🔫 ВЫСТРЕЛИТЬ В СЕБЯ"
        loadShotgun()
    end

    UseItem = function(who, itemName)
        local isPlayer = (who == "Player")
        if itemName == "Cigarettes" then
            playSFX(SOUNDS.Heal, 1.0)
            local key = isPlayer and "PlayerHP" or "DealerHP"
            GameState[key] = math.min(GameState.MaxHP, GameState[key] + 1)
            updateHPUI()
        elseif itemName == "Beer" then
            playSFX(SOUNDS.Rack, 1.1)
            table.remove(GameState.Shells, 1)
            render3DItems()
        elseif itemName == "Magnifying Glass" then
            local isLive = GameState.Shells[1]
            if isPlayer then
                LogLabel.Text = "🔍 В СТВОЛЕ: " .. (isLive and "🔴 БОЕВОЙ!" or "🔵 ХОЛОСТОЙ!")
                LogLabel.TextColor3 = isLive and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(90, 190, 255)
            end
        elseif itemName == "Handsaw" then
            playSFX(SOUNDS.Saw, 1.0)
            GameState.SawActive = true
            syncGunParts()
        end
    end

    local function fireShot(shooter, target)
        if #GameState.Shells == 0 or GameState.Busy then return end
        GameState.Busy = true

        local isLive = table.remove(GameState.Shells, 1)
        local dmg = GameState.SawActive and 2 or 1
        GameState.SawActive = false

        animate3DGun(target, isLive)

        if isLive then
            if target == "Dealer" then
                GameState.DealerHP -= dmg
                LogLabel.Text = "💥 БАХ! Дилер получил урон!"
            else
                GameState.PlayerHP -= dmg
                LogLabel.Text = "💥 БАХ! Ты получил урон!"
            end
            updateHPUI()
        else
            LogLabel.Text = "💨 ЩЕЛЧОК... ХОЛОСТОЙ."
        end

        GameState.Busy = false
        
        if GameState.PlayerHP <= 0 then
            GameState.GameOver = true
            LogLabel.Text = "💀 ТЫ ПОГИБ."
            return
        elseif GameState.DealerHP <= 0 then
            LogLabel.Text = "🏆 ПОБЕДА!"
            GameState.GameOver = true
            return
        end
        
        if isLive or shooter ~= target then
            GameState.Turn = (shooter == "Player") and "Dealer" or "Player"
            if GameState.Turn == "Dealer" then
                task.wait(1)
                fireShot("Dealer", math.random(1,2) == 1 and "Player" or "Dealer")
            end
        end
    end

    ShootDealerBtn.MouseButton1Click:Connect(function()
        if GameState.GameOver then startNewGame() return end
        if GameState.Turn == "Player" and not GameState.Busy then
            fireShot("Player", "Dealer")
        end
    end)

    ShootSelfBtn.MouseButton1Click:Connect(function()
        if GameState.GameOver then startNewGame() return end
        if GameState.Turn == "Player" and not GameState.Busy then
            fireShot("Player", "Player")
        end
    end)

    startNewGame()
end

TriggerBtn.MouseButton1Click:Connect(Launch3DBuckshot)
