    local function createItemModel(itemName, pos, colorBase, isDealer)
        local model = Instance.new("Model", WorldModel)
        
        local base = Instance.new("Part", model)
        base.Size = Vector3.new(0.4, 0.4, 0.4)
        base.Position = pos
        base.Anchored = true
        base.Color = colorBase
        base.Material = Enum.Material.SmoothPlastic
        
        if itemName == "Beer" then
            base.Size = Vector3.new(0.4, 1, 0.4)
            base.Color = Color3.fromRGB(139, 69, 19)
        elseif itemName == "Cigarettes" then
            base.Size = Vector3.new(0.8, 0.1, 0.1)
            base.Color = Color3.fromRGB(255, 255, 255)
            local tip = Instance.new("Part", model)
            tip.Size = Vector3.new(0.2, 0.11, 0.11)
            tip.Position = pos + Vector3.new(0.4, 0, 0)
            tip.Anchored = true
            tip.Color = Color3.fromRGB(255, 100, 0)
            table.insert(TableItems, tip)
        elseif itemName == "Magnifying Glass" then
            base.Shape = Enum.PartType.Cylinder
            base.Size = Vector3.new(0.1, 0.6, 0.6)
            base.Color = Color3.fromRGB(200, 200, 200)
            base.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90))
        elseif itemName == "Handsaw" then
            base.Size = Vector3.new(1.2, 0.4, 0.1)
            base.Color = Color3.fromRGB(150, 150, 150)
        elseif itemName == "Expired Medicine" then
            base.Shape = Enum.PartType.Cylinder
            base.Size = Vector3.new(0.5, 0.4, 0.4)
            base.Color = Color3.fromRGB(255, 255, 255)
        elseif itemName == "Burner Phone" then
            base.Size = Vector3.new(0.3, 0.6, 0.1)
            base.Color = Color3.fromRGB(30, 30, 30)
        elseif itemName == "Inverter" then
            base.Size = Vector3.new(0.5, 0.3, 0.3)
            base.Color = Color3.fromRGB(200, 50, 200)
        elseif itemName == "Handcuffs" then
            base.Shape = Enum.PartType.Cylinder
            base.Size = Vector3.new(0.2, 0.6, 0.6)
            base.Color = Color3.fromRGB(180, 180, 180)
            base.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(90), 0)
        else
            base.Shape = Enum.PartType.Ball
        end
        
        table.insert(TableItems, model)
        
        -- Создаем невидимую кнопку ПОВЕРХ 3D-предмета
        local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
        if onScreen then
            local clickBtn = Instance.new("TextButton", Viewport)
            clickBtn.Size = UDim2.new(0, 50, 0, 50) -- Размер кнопки
            clickBtn.AnchorPoint = Vector2.new(0.5, 0.5)
