    local function render3DItems()
        clearItems()
        
        -- Твои предметы (зеленые/желтые)
        for i, itemName in ipairs(GameState.PlayerItems) do
            local pos = Vector3.new(1.5 + (i * 0.8), 0.4, 2)
            createItemModel(itemName, pos, Color3.fromRGB(50, 255, 100), false)
        end
        
        -- Предметы дилера (красные, но если идет кража - золотые)
        local dealerColor = GameState.StealingMode and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(255, 50, 50)
        for i, itemName in ipairs(GameState.DealerItems) do
            local pos = Vector3.new(-3.5 + (i * 0.8), 0.4, -1)
            createItemModel(itemName, pos, dealerColor, true)
        end
    end

